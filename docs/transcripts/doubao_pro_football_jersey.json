    {
      "start": 758.95,
      "end": 760.95,
      "text": "拥有更多球衣的"
    },
    {
      "start": 760.95,
      "end": 761.95,
      "text": "选择自由"
    },
    {
      "start": 761.95,
      "end": 762.95,
      "text": "根据"
    },
    {
      "start": 762.95,
      "end": 763.95,
      "text": "三连生活周刊的分析。"
    },
    {
      "start": 763.95,
      "end": 765.95,
      "text": "中国对缺席世界杯。"
    },
    {
      "start": 765.95,
      "end": 766.95,
      "text": "反倒是带来了一个。"
    },
    {
      "start": 766.95,
      "end": 767.95,
      "text": "意外的效果"
    },
    {
      "start": 767.95,
      "end": 769.95,
      "text": "就是使得中国年轻人。"
    },
    {
      "start": 769.95,
      "end": 770.95,
      "text": "拥有了一种"
    },
    {
      "start": 770.95,
      "end": 771.95,
      "text": "其他足球强国年轻人。"
    },
    {
      "start": 771.95,
      "end": 772.95,
      "text": "没有的自由"
    },
    {
      "start": 772.95,
      "end": 773.95,
      "text": "由于没有必须"
    },
    {
      "start": 773.95,
      "end": 774.95,
      "text": "支持主队的期待"
    },
    {
      "start": 774.95,
      "end": 775.95,
      "text": "中国的年轻人"
    },
    {
      "start": 775.95,
      "end": 777.95,
      "text": "反倒是可以更加纯粹的。"
    },
    {
      "start": 777.95,
      "end": 778.95,
      "text": "出于个人的"
    },
    {
      "start": 778.95,
      "end": 780.95,
      "text": "审美或喜好来做选择。"
    },
    {
      "start": 780.95,
      "end": 781.95,
      "text": "像是非法官方"
    },
    {
      "start": 781.95,
      "end": 783.95,
      "text": "旗舰店的买家评论里。"
    },
    {
      "start": 783.95,
      "end": 784.95,
      "text": "也有不少关于"
    },
    {
      "start": 784.95,
      "end": 785.95,
      "text": "不同球队球衣的"
    },
    {
      "start": 785.95,
      "end": 786.95,
      "text": "穿搭分享"
    },
    {
      "start": 786.95,
      "end": 787.95,
      "text": "而且世界杯球衣"
    },
    {
      "start": 787.95,
      "end": 788.95,
      "text": "也有着越来越"
    },
    {
      "start": 788.95,
      "end": 790.95,
      "text": "明显的审美倾向"
    },
    {
      "start": 790.95,
      "end": 792.95,
      "text": "比如法国对客场球衣。"
    },
    {
      "start": 792.95,
      "end": 794.95,
      "text": "拥有薄荷绿的底色。"
    },
    {
      "start": 794.95,
      "end": 795.95,
      "text": "同色的线条"
    },
    {
      "start": 795.95,
      "end": 796.95,
      "text": "它所致敬的就是"
    },
    {
      "start": 796.95,
      "end": 798.95,
      "text": "法国送给美国的礼物。"
    },
    {
      "start": 798.95,
      "end": 799.95,
      "text": "自由女神像"
    },
    {
      "start": 799.95,
      "end": 801.95,
      "text": "再比如哥伦比亚"
    },
    {
      "start": 801.95,
      "end": 802.95,
      "text": "客场球衣"
    },
    {
      "start": 802.95,
      "end": 803.95,
      "text": "用深蓝和浅蓝"
    },
    {
      "start": 803.95,
      "end": 804.95,
      "text": "分别象征"
    },
    {
      "start": 804.95,
      "end": 806.95,
      "text": "太平洋和加勒比海。"
    },
    {
      "start": 806.95,
      "end": 807.95,
      "text": "两条蓝色之带"
    },
    {
      "start": 807.95,
      "end": 809.95,
      "text": "把两片海洋交織在一起。"
    },
    {
      "start": 812.95,
      "end": 813.95,
      "text": "原因之三"
    },
    {
      "start": 813.95,
      "end": 815.95,
      "text": "球衣具有收藏价值。"
    },
    {
      "start": 815.95,
      "end": 817.95,
      "text": "一件球衣之所以成为经典。"
    },
    {
      "start": 817.95,
      "end": 818.95,
      "text": "部分原因"
    },
    {
      "start": 818.95,
      "end": 819.95,
      "text": "也在于它所经历的。"
    },
    {
      "start": 819.95,
      "end": 820.95,
      "text": "经典时刻"
    },
    {
      "start": 820.95,
      "end": 821.95,
      "text": "而实践的流逝"
    },
    {
      "start": 821.95,
      "end": 822.95,
      "text": "也会改变"
    },
    {
      "start": 822.95,
      "end": 824.95,
      "text": "我们对一件足球球衣的看法。"
    },
    {
      "start": 824.95,
      "end": 825.95,
      "text": "和欣赏方式"
    },
    {
      "start": 825.95,
      "end": 826.95,
      "text": "这也就构成了"
    },
    {
      "start": 826.95,
      "end": 828.95,
      "text": "球衣的收藏价值"
    },
    {
      "start": 828.95,
      "end": 829.95,
      "text": "最极端的例子"
    },
    {
      "start": 829.95,
      "end": 830.95,
      "text": "是马拉多纳"
    },
    {
      "start": 830.95,
      "end": 831.95,
      "text": "1986年世界杯。"
    },
    {
      "start": 831.95,
      "end": 833.95,
      "text": "上帝之首的那件球衣。"
    },
    {
      "start": 833.95,
      "end": 835.95,
      "text": "2022年在苏福比。"
    },
    {
      "start": 835.95,
      "end": 837.95,
      "text": "拍出了700多万英镑的高价。"
    },
    {
      "start": 837.95,
      "end": 838.95,
      "text": "吉尼斯世界纪录"
    },
    {
      "start": 838.95,
      "end": 839.95,
      "text": "把它列为"
    },
    {
      "start": 839.95,
      "end": 842.95,
      "text": "拍卖成交价最高的足球球衣。"
    },
    {
      "start": 842.95,
      "end": 843.95,
      "text": "不过对于国内的球衣。"
    },
    {
      "start": 843.95,
      "end": 845.95,
      "text": "收藏爱好者来说"
    },
    {
      "start": 845.95,
      "end": 846.95,
      "text": "想要逃换一件老球衣。"
    },
    {
      "start": 846.95,
      "end": 847.95,
      "text": "并不是很容易"
    },
    {
      "start": 847.95,
      "end": 848.95,
      "text": "由于国内缺少"
    },
    {
      "start": 848.95,
      "end": 850.95,
      "text": "收藏版球衣的交易渠道。"
    },
    {
      "start": 850.95,
      "end": 851.95,
      "text": "而且市场上"
    },
    {
      "start": 851.95,
      "end": 853.95,
      "text": "还充置着倒版球衣。"
    },
    {
      "start": 853.95,
      "end": 855.95,
      "text": "所以真假也难以辨别。"
    },
    {
      "start": 855.95,
      "end": 856.95,
      "text": "那这个夏天"
    },
    {
      "start": 856.95,
      "end": 858.95,
      "text": "你购买世界杯球衣了吗？"
    },
    {
      "start": 858.95,
      "end": 859.95,
      "text": "如果是的话"
    },
    {
      "start": 859.95,
      "end": 860.95,
      "text": "你的球衣"
    },
    {
      "start": 860.95,
      "end": 861.95,
      "text": "又是属于哪支队伍的呢？"
    },
    {
      "start": 861.95,
      "end": 863.95,
      "text": "欢迎在我们的评论区。"
    },
    {
      "start": 863.95,
      "end": 864.95,
      "text": "大家一起来聊聊"
    },
    {
      "start": 864.95,
      "end": 874.59,
      "text": "说起看球赛"
    },
    {
      "start": 874.59,
      "end": 875.59,
      "text": "你南海里"
    },
    {
      "start": 875.59,
      "end": 877.59,
      "text": "第一时间想到的是什么？"
    },
    {
      "start": 877.59,
      "end": 879.59,
      "text": "是深夜酒吧突然爆发的欢呼。"
    },
    {
      "start": 879.59,
      "end": 881.59,
      "text": "是夏夜烧烤摊的烟火器。"
    },
    {
      "start": 881.59,
      "end": 883.59,
      "text": "还是堆满茶几的薯片辣条。"
    },
    {
      "start": 883.59,
      "end": 885.59,
      "text": "啤酒配小龙虾的畅快。"
    },
    {
      "start": 885.59,
      "end": 887.59,
      "text": "但是今年似乎有些特别。"
    },
    {
      "start": 887.59,
      "end": 890.59,
      "text": "赛程从凌晨1点到中午12点。"
    },
    {
      "start": 890.59,
      "end": 892.59,
      "text": "过去独属于深夜的看球仪式。"
    },
    {
      "start": 892.59,
      "end": 893.59,
      "text": "今年被拉长"
    },
    {
      "start": 893.59,
      "end": 895.59,
      "text": "成了一整天的狂欢。"
    },
    {
      "start": 895.59,
      "end": 896.59,
      "text": "凌晨3点"
    },
    {
      "start": 896.59,
      "end": 897.59,
      "text": "你可以约上朋友"
    },
    {
      "start": 897.59,
      "end": 898.59,
      "text": "啤酒烧烤小龙虾"
    },
    {
      "start": 898.59,
      "end": 899.59,
      "text": "提前备齐"
    },
    {
      "start": 899.59,
      "end": 901.59,
      "text": "边吃边等比赛开场。"
    },
    {
      "start": 901.59,
      "end": 902.59,
      "text": "早上六七点"
    },
    {
      "start": 902.59,
      "end": 904.59,
      "text": "也可以一边就着油条豆浆。"
    },
    {
      "start": 904.59,
      "end": 906.59,
      "text": "一边追着精彩对决。"
    },
    {
      "start": 906.59,
      "end": 908.59,
      "text": "到了中午直接点分外卖。"
    },
    {
      "start": 908.59,
      "end": 909.59,
      "text": "把午餐时间"
    },
    {
      "start": 909.59,
      "end": 911.59,
      "text": "变成你的川鼠光赛时间。"
    },
    {
      "start": 911.59,
      "end": 913.59,
      "text": "下午饭困想提神"
    },
    {
      "start": 913.59,
      "end": 914.59,
      "text": "就再来一杯咖啡"
    },
    {
      "start": 914.59,
      "end": 916.59,
      "text": "光赛热情持续满格。"
    },
    {
      "start": 916.59,
      "end": 918.59,
      "text": "不管你追哪个时段的赛事。"
    },
    {
      "start": 918.59,
      "end": 920.59,
      "text": "无论是夜宵下酒菜。"
    },
    {
      "start": 920.59,
      "end": 921.59,
      "text": "还是临时饮料早午餐。"
    },
    {
      "start": 921.59,
      "end": 922.59,
      "text": "上淘宝散购"
    },
    {
      "start": 922.59,
      "end": 924.59,
      "text": "想吃什么点什么？"
    },
    {
      "start": 924.59,
      "end": 925.59,
      "text": "上淘宝散购"
    },
    {
      "start": 925.59,
      "end": 926.59,
      "text": "搜大历省"
    },
    {
      "start": 926.59,
      "end": 927.59,
      "text": "拼团点外卖"
    },
    {
      "start": 927.59,
      "end": 929.59,
      "text": "低至五折起"
    },
    {
      "start": 929.59,
      "end": 931.59,
      "text": "比赛精彩开场"
    },
    {
      "start": 931.59,
      "end": 932.59,
      "text": "美味同步到位"
    },
    {
      "start": 932.59,
      "end": 933.59,
      "text": "今年足球季"
    },
    {
      "start": 933.59,
      "end": 935.59,
      "text": "你的最佳光赛搭配是什么？"
    },
    {
      "start": 935.59,
      "end": 936.59,
      "text": "欢迎在评论区"
    },
    {
      "start": 936.59,
      "end": 938.59,
      "text": "分享你的光赛套餐。"
    },
    {
      "start": 938.59,
      "end": 939.59,
      "text": "我们将从互动厅友中。"
    },
    {
      "start": 939.59,
      "end": 940.59,
      "text": "抽取三位"
    },
    {
      "start": 940.59,
      "end": 942.59,
      "text": "报销一顿看球外卖。"
    },
    {
      "start": 942.59,
      "end": 943.59,
      "text": "淘宝散购"
    },
    {
      "start": 943.59,
      "end": 945.59,
      "text": "让每一场球都更对味。"
    },
    {
      "start": 947.59,
      "end": 948.59,
      "text": "今天的生动早咖啡。"
    },
    {
      "start": 948.59,
      "end": 949.59,
      "text": "就到这里"
    },
    {
      "start": 949.59,
      "end": 950.59,
      "text": "我们明天再会"
    }
  ]
}
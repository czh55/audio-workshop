    },
    {
      "start": 837.96,
      "end": 839.96,
      "text": "记得留好联系方式。"
    },
    {
      "start": 839.96,
      "end": 840.96,
      "text": "方便我们联系到你。"
    },
    {
      "start": 840.96,
      "end": 841.96,
      "text": "另外"
